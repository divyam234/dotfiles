-	if (ret)
-		return dev_err_probe(dev, ret, "Charger initialization failed\n");
+	if (!chip->power_variant) {
+		ret = capri_charger_init(chip);
+		if (ret)
+			return dev_err_probe(dev, ret, "Charger initialization failed\n");
+		dev_info(dev, "PMI632: 500 mA / 4.4 V; hardware thermal cutoffs 5..45 C; OCV/current battery estimate\n");
+	} else {
+		/* The 4.45 V ATL battery has not been charge-validated on mainline. */
+		dev_warn(dev, "Moto G10 Power SKU5: battery telemetry only, charging locked out\n");
+	}
 	schedule_delayed_work(&chip->work, 0);
-	dev_info(dev, "PMI632: 500 mA / 4.4 V; hardware thermal cutoffs 5..45 C; OCV/current battery estimate\n");
 	return 0;
 }
 
diff --git a/arch/arm64/boot/dts/qcom/capri-power-battery.dtsi b/arch/arm64/boot/dts/qcom/capri-power-battery.dtsi
