+	chip->behaviour = (charging && !chip->power_variant) ? POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
 		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
 	chip->thermal_blocked = true;
 	platform_set_drvdata(pdev, chip);
@@ -587,11 +591,16 @@ static int capri_probe(struct platform_device *pdev)
 	ret = capri_temperature(chip);
 	if (ret)
 		return dev_err_probe(dev, ret, "Battery temperature read failed\n");
