 	case POWER_SUPPLY_PROP_HEALTH: value->intval = chip->health; break;
@@ -480,6 +480,9 @@ static int capri_set(struct power_supply *psy, enum power_supply_property prop,
 	    (value->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
