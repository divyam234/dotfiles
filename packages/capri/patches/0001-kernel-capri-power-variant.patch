+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX: value->intval = chip->info->constant_charge_current_max_ua; break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE_MAX: value->intval = chip->info->constant_charge_voltage_max_uv; break;
