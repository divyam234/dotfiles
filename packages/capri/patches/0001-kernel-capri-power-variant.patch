index 0000000..d112842
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/capri-power-battery.dtsi
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Moto G10 Power (capri SKU5) battery data for initial kernel validation.
+ *
+ * Sources:
+ * LineageOS/android_kernel_motorola_sm6225, lineage-24.0:
+ *   bengal-capri-charge-6000-overlay.dtsi
+ *   qg-batterydata-atl4864356_5640mAh.dtsi
+ *
+ * OCV values below are the 25 C column from qcom,pc-temp-v1-lut
+ * (stock units: 0.1 mV, converted to microvolts). This is only a
+ * 25 C approximation; temperature-dependent fuel-gauge LUTs and
+ * charging behavior still require calibration and live verification.
+ *
+ * Stock profile: ATL4864356, 100 kOhm battery ID, 10 kOhm thermistor,
+ * beta 3435; 4.45 V / 3 A permitted by the factory configuration.
+ * These factory maxima describe the PACK; they DO NOT authorize
+ * activating the experimental mainline charge controller.
+ */
+/ {
+	/* This node is declared in the regular Capri DTS; override it. */
+};
+
+&capri_battery {
+	charge-full-design-microamp-hours = <6000000>;
+	voltage-max-design-microvolt = <4450000>;
+	constant-charge-current-max-microamp = <3000000>;
+	constant-charge-voltage-max-microvolt = <4450000>;
+	charge-term-current-microamp = <290000>;
+	ocv-capacity-celsius = <25>;
+	ocv-capacity-table-0 =
+		<4434000 100>,
+		<4408700 98>,
+		<4386300 96>,
+		<4364900 94>,
+		<4343000 92>,
+		<4319600 90>,
+		<4295400 88>,
+		<4270800 86>,
+		<4245700 84>,
+		<4221000 82>,
+		<4196500 80>,
+		<4172400 78>,
+		<4148600 76>,
+		<4125500 74>,
+		<4103300 72>,
+		<4081900 70>,
+		<4061200 68>,
+		<4041200 66>,
+		<4022400 64>,
+		<4005200 62>,
+		<3987800 60>,
+		<3969200 58>,
+		<3949600 56>,
+		<3926700 54>,
+		<3901500 52>,
+		<3885400 50>,
+		<3875700 48>,
+		<3867100 46>,
+		<3857900 44>,
+		<3849000 42>,
+		<3841200 40>,
+		<3833900 38>,
+		<3827800 36>,
+		<3822500 34>,
+		<3817700 32>,
+		<3813200 30>,
+		<3808700 28>,
+		<3804200 26>,
+		<3799400 24>,
+		<3792100 22>,
+		<3780800 20>,
+		<3768100 18>,
+		<3754300 16>,
+		<3738500 14>,
+		<3721600 12>,
+		<3710600 10>,
+		<3707900 9>,
+		<3705600 8>,
+		<3703700 7>,
+		<3700400 6>,
+		<3682100 5>,
+		<3639700 4>,
+		<3582700 3>,
+		<3505200 2>,
+		<3386400 1>,
+		<3000000 0>;
+};
+
+/* Tell the power driver this pack has not had its charger verified. */
+&spmi_bus {
+	pmic@2 {
+		battery-monitor@4800 {
+			motorola,capri-power-battery;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm4250-motorola-capri-power.dts b/arch/arm64/boot/dts/qcom/sm4250-motorola-capri-power.dts
new file mode 100644
index 0000000..3041802
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm4250-motorola-capri-power.dts
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Motorola Moto G10 Power XT2127-4, capri SKU5.
+ * Inherit working Capri base and apply the factory 6000-mAh SKU profile.
+ * Stock DVT2 SKU5 board ID: <0x500 0xb200>.
+ * EVT SKU5 uses <0x500 0xa000> and is not selected here.
+ *
+ * EXPERIMENTAL: verify actual hardware board ID before trying fastboot.
+ */
+#include "sm4250-motorola-capri.dts"
+#include "capri-power-battery.dtsi"
+
+/ {
+	model = "Motorola Moto G10 Power (XT2127-4)";
+	compatible = "motorola,capri", "qcom,sm4250";
+	qcom,board-id = <0x500 0xb200>;
+};
