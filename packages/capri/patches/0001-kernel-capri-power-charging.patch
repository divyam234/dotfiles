new file mode 100644
index 0000000..88487d8
--- /dev/null
+++ b/drivers/power/supply/capri-pmi632-controller.h
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _CAPRI_PMI632_CONTROLLER_H
+#define _CAPRI_PMI632_CONTROLLER_H
+
+/*
+ * Capri Power / PMI632 charge-controller policy, in SHADOW MODE.
+ *
+ * Motorola's SKU5 temperature-zone thresholds are 0, 10, 15, 45, 60 C
+ * with 4.20 V derating outside the central zone. This controller
+ * intentionally narrows the *unvalidated* operating window to 15..40 C.
+ * SDP is capped to its existing 500 mA input limit. The planned battery
+ * FCC is only a dry-run target, and is never applied to PMIC hardware.
+ *
+ * The Power driver retains the independent charging lockout, skips
+ * charger initialization, and rejects charge-behaviour AUTO requests.
+ * These pure calculations MUST NOT be used as proof of hardware safety.
+ */
+enum capri_control_zone {
+	CAPRI_ZONE_COLD = 0,
+	CAPRI_ZONE_COOL_0_10,
+	CAPRI_ZONE_COOL_10_15,
+	CAPRI_ZONE_NORMAL,
+	CAPRI_ZONE_WARM_45_60,
+	CAPRI_ZONE_HOT,
+};
+
+enum capri_control_reason {
+	CAPRI_CTL_NO_SOURCE        = 1U << 0,
+	CAPRI_CTL_SOURCE_UNVERIFIED= 1U << 1,
+	CAPRI_CTL_BAD_GAUGE        = 1U << 2,
+	CAPRI_CTL_TEMP_OUTSIDE     = 1U << 3,
+	CAPRI_CTL_FAULT_LATCHED    = 1U << 4,
+	CAPRI_CTL_INPUT_INVALID    = 1U << 5,
+	CAPRI_CTL_HIGH_BATTERY     = 1U << 6,
+	CAPRI_CTL_TERMINATION      = 1U << 7,
+	CAPRI_CTL_SESSION_TIMEOUT  = 1U << 8,
+	CAPRI_CTL_STABILIZING      = 1U << 9,
+	CAPRI_CTL_WDOG_BARK        = 1U << 10,
+	CAPRI_CTL_HARDWARE_LOCKOUT = 1U << 11,
+	CAPRI_CTL_CHARGER_FAULT    = 1U << 12,
+};
+
+struct capri_control_observation {
+	bool usb_online;
+	bool usb_sample_valid;
+	bool usb_path_valid;
+	bool aicl_done;
+	bool usb_sdp;
+	bool usb_cdp;
+	bool usb_dcp;
+	bool battery_present;
+	bool gauge_valid;
+	bool health_good;
+	bool charger_fault;
+	bool watchdog_bark;
+	/* This is a QG reading, not validated as calibrated charge current. */
+	bool charge_current_calibrated;
+	/* Prevent passive near-full ADC samples from counting as taper. */
+	bool charging_active;
+	/* True when Power PMIC setup succeeds and charge behaviour is AUTO. */
+	bool runtime_charge_enabled;
+	int temperature_decic;
+	int battery_voltage_uv;
+	int charge_current_ua;
+	int usb_voltage_uv;
+	int usb_icl_ua;
+	/* Milliseconds of source-connected session, measured monotonic. */
+	unsigned long long session_elapsed_ms;
+};
+
+struct capri_control_state {
+	bool wdog_latched;
+	bool fault_latched;
+	bool terminated;
+	bool was_connected;
+	unsigned int stable_samples;
+	unsigned int taper_samples;
+};
+
+struct capri_control_plan {
+	unsigned int reasons;
+	enum capri_control_zone zone;
+	int usb_icl_ua, fcc_ua, fv_uv;
+	bool source_candidate;
+	bool charging_permitted;
+};
+
+static inline enum capri_control_zone capri_control_temp_zone(int decic)
+{
+	if (decic < 0)
+		return CAPRI_ZONE_COLD;
+	if (decic < 100)
+		return CAPRI_ZONE_COOL_0_10;
+	if (decic < 150)
+		return CAPRI_ZONE_COOL_10_15;
+	if (decic < 450)
+		return CAPRI_ZONE_NORMAL;
+	if (decic < 600)
+		return CAPRI_ZONE_WARM_45_60;
+	return CAPRI_ZONE_HOT;
+}
+
+/*
+ * All state changes are a pure function of previous state and telemetry.
+ * This allows hostile/faulty inputs to be tested without powering a pack.
+ *
+ * Termination intentionally remains unqualified on an uncalibrated QGauge:
+ * the stock 290 mA MMI stop policy is NOT the signed -102 mA ADC comparator.
+ * For an eventual independent validation, only positive, verified QG charge
+ * current near FV can count toward the three-sample taper condition.
+ */
+static inline struct capri_control_plan capri_control_calculate(
+	struct capri_control_state *s,
+	const struct capri_control_observation *o)
+{
+	struct capri_control_plan p = {
+		.reasons = o->runtime_charge_enabled ? 0 : CAPRI_CTL_HARDWARE_LOCKOUT,
+		.zone = capri_control_temp_zone(o->temperature_decic),
+		.usb_icl_ua = 0,
+		.fcc_ua = 0,
+		.fv_uv = 0,
+		.charging_permitted = false,
+	};
+	bool source_good, sensor_good;
+
+	if (!o->usb_online) {
+		s->was_connected = false;
+		s->stable_samples = 0;
+		s->taper_samples = 0;
+		s->terminated = false;
+		p.reasons |= CAPRI_CTL_NO_SOURCE;
+		return p;
+	}
+	if (!s->was_connected) {
+		s->was_connected = true;
+		s->stable_samples = 0;
+		s->taper_samples = 0;
+	}
+	/* Watchdog bark or critical charger fault: do not clear on unplug.
+	 * A fresh boot and hardware validation are required to reset it.
+	 */
+	if (o->watchdog_bark)
+		s->wdog_latched = true;
+	if (s->wdog_latched)
+		p.reasons |= CAPRI_CTL_WDOG_BARK | CAPRI_CTL_FAULT_LATCHED;
+	if (o->charger_fault)
+		s->fault_latched = true;
+	if (s->fault_latched)
+		p.reasons |= CAPRI_CTL_CHARGER_FAULT | CAPRI_CTL_FAULT_LATCHED;
+
+	if (!o->battery_present || !o->gauge_valid || !o->health_good)
+		p.reasons |= CAPRI_CTL_BAD_GAUGE;
+
+	if (o->temperature_decic < 150 || o->temperature_decic >= 400)
+		p.reasons |= CAPRI_CTL_TEMP_OUTSIDE;
+
+	/* Derated targets reflect the stock temperature table, but are
+	 * not an authorization to charge outside the validated zone.
+	 */
+	p.fv_uv = (p.zone == CAPRI_ZONE_NORMAL &&
+		   o->temperature_decic < 400) ? 4450000 : 4200000;
+
+	source_good = (o->usb_sdp || o->usb_cdp || o->usb_dcp) &&
+		      o->usb_sample_valid;
+	if (!(o->usb_sdp || o->usb_cdp || o->usb_dcp))
+		p.reasons |= CAPRI_CTL_SOURCE_UNVERIFIED;
+	if (!o->usb_sample_valid || !o->usb_path_valid || !o->aicl_done)
+		p.reasons |= CAPRI_CTL_INPUT_INVALID;
+	if (o->usb_icl_ua < 100000 || o->usb_icl_ua > 500000 ||
+	    o->usb_voltage_uv < 4500000 || o->usb_voltage_uv > 5500000) {
+		p.reasons |= CAPRI_CTL_INPUT_INVALID;
+		source_good = false;
+	}
+
+	sensor_good = o->gauge_valid && o->battery_present && o->health_good &&
+		      o->battery_voltage_uv >= 2500000 &&
+		      o->battery_voltage_uv < p.fv_uv;
+	if (o->battery_voltage_uv < 2500000 ||
+	    o->battery_voltage_uv >= p.fv_uv)
+		p.reasons |= CAPRI_CTL_HIGH_BATTERY;
+
+	/* The SMB5 fast-charge safety timer uses 768 min in Motorola's
+	 * downstream initialization. Mirror that absolute session limit.
+	 * Hardware enforcement is still a separate, unvalidated guard.
+	 */
+	if (o->session_elapsed_ms > 768ULL * 60 * 1000)
+		p.reasons |= CAPRI_CTL_SESSION_TIMEOUT;
+
+	if (o->charging_active && o->charge_current_calibrated &&
+	    o->charge_current_ua >= 0 &&
+	    o->battery_voltage_uv >= p.fv_uv - 20000 &&
+	    o->charge_current_ua <= 102000) {
+		if (s->taper_samples < 3)
+			++s->taper_samples;
+		if (s->taper_samples >= 3)
+			s->terminated = true;
+	} else {
+		s->taper_samples = 0;
+	}
+	if (s->terminated)
+		p.reasons |= CAPRI_CTL_TERMINATION;
+
+	/* Three fresh successful observations avoid programming setpoints
+	 * from a single transient AICL or ADC sample. No register writes.
+	 */
+	if (source_good && sensor_good && p.zone == CAPRI_ZONE_NORMAL &&
+	    o->temperature_decic < 400 &&
+	    !s->fault_latched && !s->wdog_latched) {
+		if (s->stable_samples < 3)
+			++s->stable_samples;
+	} else {
+		s->stable_samples = 0;
+	}
+	if (s->stable_samples < 3)
+		p.reasons |= CAPRI_CTL_STABILIZING;
+
+	/* 500 mA SDP input is not a grant of 500 mA battery FCC. Reserve
+	 * at least 250 mA input for the measured 171..234 mA system load;
+	 * 200 mA is a conservative DRY-RUN battery current target only.
+	 */
+	if (p.reasons == 0 || p.reasons == CAPRI_CTL_HARDWARE_LOCKOUT) {
+		p.usb_icl_ua = o->usb_icl_ua;
+		p.fcc_ua = 200000;
+		p.source_candidate = true;
+	}
+	/* The caller still validates actual PMIC programming and charging
+	 * switch state before applying any requested charge current.
+	 */
+	p.charging_permitted = p.source_candidate && o->runtime_charge_enabled;
+	return p;
+}
+
+#endif /* _CAPRI_PMI632_CONTROLLER_H */
diff --git a/drivers/power/supply/capri-pmi632-policy.h b/drivers/power/supply/capri-pmi632-policy.h
new file mode 100644
index 0000000..e027829
--- /dev/null
+++ b/drivers/power/supply/capri-pmi632-policy.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _CAPRI_PMI632_POWER_POLICY_H
+#define _CAPRI_PMI632_POWER_POLICY_H
+
+/*
+ * Moto G10 Power SKU5: pure, side-effect-free charge safety audit.
+ *
+ * This is NOT an enable-charging state machine. The Power hardware path
+ * cannot charge as a result of any value returned from here. All paths
+ * deliberately retain LOCKOUT and the independent, unvalidated protections.
+ *
+ * Keep this interface simple enough to compile with a native C test harness.
+ */
+enum capri_power_blocker {
+	CAPRI_BLOCK_LOCKOUT            = 1U << 0,
+	CAPRI_BLOCK_NO_BATTERY         = 1U << 1,
+	CAPRI_BLOCK_NO_USB             = 1U << 2,
+	CAPRI_BLOCK_USB_SAMPLE         = 1U << 3,
+	CAPRI_BLOCK_INPUT_PATH         = 1U << 4,
+	CAPRI_BLOCK_AICL_PENDING       = 1U << 5,
+	CAPRI_BLOCK_SOURCE_UNVERIFIED  = 1U << 6,
+	CAPRI_BLOCK_INPUT_LIMIT       = 1U << 7,
+	CAPRI_BLOCK_TEMPERATURE       = 1U << 8,
+	CAPRI_BLOCK_VOLTAGE           = 1U << 9,
+	CAPRI_BLOCK_BATTERY_HEALTH    = 1U << 10,
+	CAPRI_BLOCK_CHARGER_FAULT     = 1U << 11,
+	CAPRI_BLOCK_CMD_NOT_DISABLED  = 1U << 12,
+	CAPRI_BLOCK_WDOG_CONFIG       = 1U << 13,
+	CAPRI_BLOCK_TIMER_CONFIG      = 1U << 14,
+	CAPRI_BLOCK_ITERM_CONFIG      = 1U << 15,
+	CAPRI_BLOCK_HW_READ_FAILED    = 1U << 16,
+	CAPRI_BLOCK_JEITA_UNVERIFIED  = 1U << 17,
+	CAPRI_BLOCK_WDOG_UNVERIFIED   = 1U << 18,
+	CAPRI_BLOCK_ITERM_UNVERIFIED  = 1U << 19,
+	CAPRI_BLOCK_QG_UNCALIBRATED   = 1U << 20,
+	CAPRI_BLOCK_SOURCE_POLICY     = 1U << 21,
+	CAPRI_BLOCK_HW_CHARGE_LIMITS   = 1U << 22,
+	CAPRI_BLOCK_GAUGE_SAMPLE      = 1U << 23,
+};
+
+/* No Linux-specific dependencies: a host-native regression test exercises
+ * the exact policy function that the kernel calls in its periodic audit.
+ */
+struct capri_power_policy_inputs {
+	bool battery_present;
+	bool gauge_sample_valid;
+	bool usb_online;
+	bool usb_sample_valid;
+	bool usb_path_valid;
+	bool aicl_done;
+	bool source_is_sdp;
+	bool battery_healthy;
+	bool charger_fault;
+	bool hw_read_valid;
+	bool charge_cmd_disabled;
+	bool watchdog_cfg_matches;
+	bool timer_cfg_matches;
+	bool iterm_cfg_matches;
+	bool hw_charge_limits_match;
+	int temperature_decic;
+	int battery_voltage_uv;
+	int usb_voltage_uv;
+	int usb_icl_ua;
+};
+
+/* This gate MUST always block charging until the unvalidated components
+ * (JEITA, watchdog bite, termination, current sign, USB role) have tests.
+ * A zero mask is an invalid state for the Power model.
+ */
+static inline unsigned int
+capri_power_policy_blockers(const struct capri_power_policy_inputs *in)
+{
+	unsigned int blocked = CAPRI_BLOCK_LOCKOUT |
+			       CAPRI_BLOCK_JEITA_UNVERIFIED |
+			       CAPRI_BLOCK_WDOG_UNVERIFIED |
+			       CAPRI_BLOCK_ITERM_UNVERIFIED |
+			       CAPRI_BLOCK_QG_UNCALIBRATED |
+			       CAPRI_BLOCK_SOURCE_POLICY;
+	if (!in->gauge_sample_valid)
+		blocked |= CAPRI_BLOCK_GAUGE_SAMPLE;
+
+	if (!in->battery_present)
+		blocked |= CAPRI_BLOCK_NO_BATTERY;
+	if (!in->usb_online)
+		blocked |= CAPRI_BLOCK_NO_USB;
+	if (!in->usb_sample_valid)
+		blocked |= CAPRI_BLOCK_USB_SAMPLE;
+	if (!in->usb_path_valid)
+		blocked |= CAPRI_BLOCK_INPUT_PATH;
+	if (!in->aicl_done)
+		blocked |= CAPRI_BLOCK_AICL_PENDING;
+	/* Until Type-C negotiated source ownership is implemented, only
+	 * observed SDP with a <=500 mA hardware limit is a test candidate.
+	 * This does NOT authorize a new ICL or FCC write.
+	 */
+	if (!in->source_is_sdp)
+		blocked |= CAPRI_BLOCK_SOURCE_UNVERIFIED;
+	if (in->usb_icl_ua <= 0 || in->usb_icl_ua > 500000 ||
+	    in->usb_voltage_uv < 4500000 || in->usb_voltage_uv > 5500000)
+		blocked |= CAPRI_BLOCK_INPUT_LIMIT;
+	if (in->temperature_decic < 100 || in->temperature_decic > 400)
+		blocked |= CAPRI_BLOCK_TEMPERATURE;
+	if (in->battery_voltage_uv < 2500000 ||
+	    in->battery_voltage_uv >= 4450000)
+		blocked |= CAPRI_BLOCK_VOLTAGE;
+	if (!in->battery_healthy)
+		blocked |= CAPRI_BLOCK_BATTERY_HEALTH;
+	if (in->charger_fault)
+		blocked |= CAPRI_BLOCK_CHARGER_FAULT;
+	if (!in->hw_read_valid) {
+		blocked |= CAPRI_BLOCK_HW_READ_FAILED;
+		/* Read failures cannot accidentally clear a hardware blocker. */
+		blocked |= CAPRI_BLOCK_CMD_NOT_DISABLED |
+			   CAPRI_BLOCK_WDOG_CONFIG |
+			   CAPRI_BLOCK_TIMER_CONFIG |
+			   CAPRI_BLOCK_ITERM_CONFIG |
+			   CAPRI_BLOCK_HW_CHARGE_LIMITS;
+	} else {
+		if (!in->charge_cmd_disabled)
+			blocked |= CAPRI_BLOCK_CMD_NOT_DISABLED;
+		if (!in->watchdog_cfg_matches)
+			blocked |= CAPRI_BLOCK_WDOG_CONFIG;
+		if (!in->timer_cfg_matches)
+			blocked |= CAPRI_BLOCK_TIMER_CONFIG;
+		if (!in->iterm_cfg_matches)
+			blocked |= CAPRI_BLOCK_ITERM_CONFIG;
+		if (!in->hw_charge_limits_match)
+			blocked |= CAPRI_BLOCK_HW_CHARGE_LIMITS;
+	}
+	return blocked;
+}
+
+#endif /* _CAPRI_PMI632_POWER_POLICY_H */
diff --git a/drivers/power/supply/capri-pmi632-power-charger.h b/drivers/power/supply/capri-pmi632-power-charger.h
new file mode 100644
index 0000000..fb2e2d2
--- /dev/null
+++ b/drivers/power/supply/capri-pmi632-power-charger.h
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PMI632 / Moto G10 Power (SKU5) charger control.
+ *
+ * The Power entrypoint is selected by its device tree and requires no
+ * extra boot parameter. Hardware configuration is performed while the PMIC
+ * charging-enable command is held low. Limits are deliberately restricted
+ * to a detected 5V/500mA USB source and 200mA battery FCC.
+ *
+ * Motorola's PMI632 SMB5 definitions are the source for registers and scales.
+ * These functions are not a replacement for external validation of power,
+ * JEITA, watchdog and pack termination behaviour.
+ *
+ * Included after struct capri_battery and the Capri non-Power charger helpers.
+ */
+#ifndef _CAPRI_PMI632_POWER_CHARGER_H
+#define _CAPRI_PMI632_POWER_CHARGER_H
+
+/* The Motorola ATL pack is 4.45 V and allows up to 3 A *factory*
+ * charging current. The 500 mA input and 200 mA FCC limits below are
+ * conservative USB-A diagnostics, not battery factory defaults.
+ *
+ * Leave the device's initialized JEITA, watchdog, ITERM, recharge,
+ * safety timer and float voltage settings untouched. Values were
+ * observed on this XT2127-4 in read-only RAMUI and cross-checked with
+ * stock Android; reject unknown PMIC states instead of overwriting them.
+ */
+#define CAPRI_POWER_FCC_UA         200000
+#define CAPRI_POWER_USB_ICL_UA     500000
+#define CAPRI_POWER_FV_UV          4450000
+#define CAPRI_POWER_TERM_UA        102000
+#define CAPRI_POWER_WDOG_MASK      (BIT(7) | BIT(6) | BIT(1))
+#define CAPRI_POWER_WDOG_CFG       (BIT(6) | BIT(1))
+#define CAPRI_POWER_WDOG_TIMEOUT   (BIT(7) | BIT(3) | BIT(2)) /* stock 0x8c */
+#define CAPRI_POWER_JEITA_MASK     GENMASK(3, 0)
+#define CAPRI_POWER_JEITA_CFG      (BIT(3) | BIT(1) | BIT(0)) /* stock 0x1b */
+#define CAPRI_POWER_TIMER_CFG      2U  /* stock 768 minutes */
+
+/* Use observed OEM-initialized PMI632 protections rather than programming
+ * a second, incompatible JEITA/watchdog/termination profile. Charging stays
+ * disabled until all readbacks have passed. Only cap FCC to 200 mA for the
+ * tested 500 mA SDP supply. This is NOT a 3 A charging authorization.
+ */
+static int capri_power_set_limits_disabled(struct capri_battery *chip)
+{
+	unsigned int cfg, fcc_setting, fv, timer, wd, bark, icl, jeita, term_mode;
+	u8 term_readback[2];
+	int ret, iterm_ua;
+
+	if (!chip->power_variant ||
+	    chip->info->constant_charge_voltage_max_uv != CAPRI_POWER_FV_UV ||
+	    chip->info->constant_charge_current_max_ua != 3000000 ||
+	    chip->info->charge_term_current_ua != 290000)
+		return -EINVAL;
+
+	ret = capri_disable_charging(chip);
+	if (ret)
+		return ret;
+
+#define CAPRI_READ_OR_FAIL(_addr, _out) do { \
+	ret = regmap_read(chip->map, (_addr), &(_out)); \
+	if (ret) \
+		goto fail; \
+} while (0)
+	CAPRI_READ_OR_FAIL(CHGR_ENABLE, cfg);
+	CAPRI_READ_OR_FAIL(CHGR_FCC, fcc_setting);
+	CAPRI_READ_OR_FAIL(CHGR_FV, fv);
+	CAPRI_READ_OR_FAIL(CAPRI_SAFETY_TIMER, timer);
+	CAPRI_READ_OR_FAIL(WD_CFG, wd);
+	CAPRI_READ_OR_FAIL(WD_TIMEOUT, bark);
+	CAPRI_READ_OR_FAIL(0x1370, icl);
+	CAPRI_READ_OR_FAIL(0x1090, jeita);
+	CAPRI_READ_OR_FAIL(CAPRI_ITERM_SOURCE, term_mode);
+#undef CAPRI_READ_OR_FAIL
+	ret = regmap_bulk_read(chip->map, CAPRI_ITERM_UPPER,
+			       term_readback, sizeof(term_readback));
+	if (ret)
+		goto fail;
+	iterm_ua = div_s64((s64)(s16)get_unaligned_be16(term_readback) *
+			   5000000, 32767);
+
+	/* The registered phone exposed 2 A FCC, 4.45 V FV, 500 mA USB ICL,
+	 * JEITA=0x1b, watchdog=0x62/0x8c, timer=0x02 and -102 mA ITERM.
+	 * Other firmware configurations must be inspected first.
+	 */
+	if ((cfg & BIT(0)) || fcc_setting == 0 || fcc_setting > 60 ||
+	    fv != (CAPRI_POWER_FV_UV - 3600000) / 10000 ||
+	    icl == 0 || icl > CAPRI_POWER_USB_ICL_UA / 50000 ||
+	    (timer & GENMASK(1, 0)) != CAPRI_POWER_TIMER_CFG ||
+	    (wd & CAPRI_POWER_WDOG_MASK) != CAPRI_POWER_WDOG_CFG ||
+	    (bark & (BIT(7) | GENMASK(3, 0))) !=
+					CAPRI_POWER_WDOG_TIMEOUT ||
+	    (jeita & CAPRI_POWER_JEITA_MASK) != CAPRI_POWER_JEITA_CFG ||
+	    (term_mode & BIT(3)) ||
+	    abs(iterm_ua + CAPRI_POWER_TERM_UA) > 10000) {
+		ret = -EINVAL;
+		goto fail;
+	}
+
+	/* OEM safety configuration is retained. Only the FCC is limited for
+	 * the already measured USB-A input. The PMIC still owns AICL.
+	 */
+	ret = regmap_write(chip->map, CHGR_FCC, CAPRI_POWER_FCC_UA / 50000);
+	if (ret)
+		goto fail;
+	ret = regmap_read(chip->map, CHGR_FCC, &fcc_setting);
+	if (ret)
+		goto fail;
+	if (fcc_setting != CAPRI_POWER_FCC_UA / 50000) {
+		ret = -EIO;
+		goto fail;
+	}
+
+	chip->fcc_code = fcc_setting;
+	chip->fv_code = fv;
+	chip->charger_ready = true;
+	return 0;
+
+fail:
+	capri_disable_charging(chip);
+	return ret;
+}
+
+/* Runtime path is event-driven on USB and PMI632 IRQs, plus 5-second
+ * thermal/watchdog sampling. All unsafe transitions disable charge.
+ */
+static int capri_power_charge_update(struct capri_battery *chip)
+{
+	struct capri_power_hw_audit *a = &chip->audit;
+	struct capri_control_plan *p = &a->control_plan;
+	unsigned int fcc_setting, voltage, wd, bark, timer, enable_bit;
+	bool should_charge;
+	int ret;
+
+	if (!chip->power_variant || !chip->charger_ready)
+		return 0;
+	/* The hard thermistor limits are programmed into PMI632; use
+	 * tighter software limits with hysteresis in 15..40 C.
+	 */
+	if (chip->temperature < 150 || chip->temperature >= 400)
+		chip->thermal_blocked = true;
+	else if (chip->temperature >= 170 && chip->temperature <= 380)
+		chip->thermal_blocked = false;
+
+	should_charge = p->charging_permitted &&
+		chip->behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		!chip->stopping && chip->valid &&
+		chip->status != POWER_SUPPLY_STATUS_FULL &&
+		!a->control_state.wdog_latched &&
+		!a->control_state.fault_latched &&
+		!READ_ONCE(chip->wdog_bark_latched) &&
+		!a->read_error && a->valid &&
+		(a->jeita & CAPRI_POWER_JEITA_MASK) == CAPRI_POWER_JEITA_CFG &&
+		(a->iterm_mode & BIT(3)) == 0 &&
+		abs(a->iterm_ua + CAPRI_POWER_TERM_UA) <= 10000 &&
+		!chip->thermal_blocked &&
+		chip->temperature >= 150 && chip->temperature < 400 &&
+		chip->voltage < CAPRI_POWER_FV_UV &&
+		chip->usb_input_valid && chip->input_path_valid &&
+		chip->usb_input_current_limit_ua > 0 &&
+		chip->usb_input_current_limit_ua <= 500000 &&
+		chip->usb_in_voltage_uv >= 4500000 &&
+		chip->usb_in_voltage_uv <= 5500000;
+
+	ret = regmap_read(chip->map, CHGR_FCC, &fcc_setting);
+	if (ret)
+		goto error;
+	ret = regmap_read(chip->map, CHGR_FV, &voltage);
+	if (ret)
+		goto error;
+	ret = regmap_read(chip->map, WD_CFG, &wd);
+	if (ret)
+		goto error;
+	ret = regmap_read(chip->map, WD_TIMEOUT, &bark);
+	if (ret)
+		goto error;
+	ret = regmap_read(chip->map, CAPRI_SAFETY_TIMER, &timer);
+	if (ret)
+		goto error;
+	ret = regmap_read(chip->map, CHGR_ENABLE, &enable_bit);
+	if (ret)
+		goto error;
+	if (fcc_setting != chip->fcc_code || voltage != chip->fv_code ||
+	    (wd & CAPRI_POWER_WDOG_MASK) != CAPRI_POWER_WDOG_CFG ||
+	    (bark & (BIT(7) | GENMASK(3, 0))) !=
+						CAPRI_POWER_WDOG_TIMEOUT ||
+	    (timer & GENMASK(1, 0)) != CAPRI_POWER_TIMER_CFG) {
+		ret = -EIO;
+		goto error;
+	}
+	if (!should_charge) {
+		if (enable_bit & BIT(0))
+			return capri_disable_charging(chip);
+		return 0;
+	}
+	/* Avoid repeatedly issuing enable writes. The PMIC may have
+	 * terminated on its own and left the command bit enabled.
+	 */
+	if (!(enable_bit & BIT(0))) {
+		ret = regmap_write(chip->map, WD_PET, BIT(0));
+		if (ret)
+			goto error;
+		ret = regmap_update_bits(chip->map, CHGR_ENABLE,
+					 BIT(0), BIT(0));
+		if (ret)
+			goto error;
+	} else {
+		ret = regmap_write(chip->map, WD_PET, BIT(0));
+		if (ret)
+			goto error;
+	}
+	return 0;
+error:
+	capri_disable_charging(chip);
+	a->control_state.fault_latched = true;
+	return ret;
+}
+
+#endif /* _CAPRI_PMI632_POWER_CHARGER_H */
