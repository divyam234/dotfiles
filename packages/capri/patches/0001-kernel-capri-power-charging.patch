 /* Motorola qcom-vadc-common.c, GPL-2.0-only: 10 kOhm NTC, 30 kOhm
@@ -296,6 +332,82 @@ static int capri_charger_update(struct capri_battery *chip)
 	return regmap_update_bits(chip->map, CHGR_ENABLE, BIT(0), enable ? BIT(0) : 0);
 }
 
+/* Read-only PMI632 USB source detection and input measurement. APSD is
+ * BC1.2 classification, not a negotiated Type-C current authorization.
+ */
+static int capri_power_sample_input(struct capri_battery *chip)
+{
+	unsigned int path, apsd, result = 0, aicl, icl;
+	int v_uv, sense_uv, ret;
+
+	chip->usb_input_valid = false;
+	chip->input_path_valid = false;
+	chip->aicl_done = false;
+	chip->aicl_limited = false;
+	chip->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	chip->usb_in_voltage_uv = 0;
+	chip->usb_in_current_ua = 0;
+	chip->usb_input_current_limit_ua = 0;
+	if (!chip->online) {
+		chip->usb_input_valid = true;
+		return 0;
+	}
+	ret = regmap_read(chip->map, CAPRI_POWER_PATH_STATUS, &path);
+	if (ret)
+		return ret;
+	chip->input_path_valid = (path & (BIT(0) | BIT(4))) ==
+				 (BIT(0) | BIT(4)) && !(path & BIT(6));
+
+	ret = regmap_read(chip->map, CAPRI_APSD_STATUS, &apsd);
+	if (ret)
+		return ret;
+	if (apsd & CAPRI_APSD_DONE) {
+		ret = regmap_read(chip->map, CAPRI_APSD_RESULT, &result);
+		if (ret)
+			return ret;
+		result &= GENMASK(6, 0);
+		if (result == CAPRI_APSD_CDP)
+			chip->usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+		else if (result == CAPRI_APSD_SDP)
+			chip->usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+		else if (result == CAPRI_APSD_DCP ||
+			 result == CAPRI_APSD_OCP)
+			chip->usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+	}
+	ret = regmap_read(chip->map, CAPRI_AICL_STATUS, &aicl);
+	if (ret)
+		return ret;
+	chip->aicl_done = !!(aicl & BIT(0));
+	chip->aicl_limited = !!(aicl & BIT(6));
+	ret = regmap_read(chip->map, CAPRI_ICL_STATUS, &icl);
+	if (ret)
+		return ret;
+	/* PMI632 effective ICL status uses 50 mA increments, 0..3 A. */
+	if (icl > 60)
+		return -ERANGE;
+	chip->usb_input_current_limit_ua = icl * 50000;
+	/* Keep the path-valid bit for policy decisions, but sample USB sense
+	 * even when the input path has been suspended by firmware.
+	 */
+
+	ret = iio_read_channel_processed(chip->usb_in_v, &v_uv);
+	if (ret < 0)
+		return ret;
+	ret = iio_read_channel_processed(chip->usb_in_i, &sense_uv);
+	if (ret < 0)
+		return ret;
+	/* ADC5 reports uV; PMI632 USB sense is 0.2 V/A, so 5 uA/uV.
+	 * These values are diagnostics, not approval to draw more power.
+	 */
+	if (v_uv < 0 || v_uv > 12000000 ||
+	    sense_uv < -10000 || sense_uv > 700000)
+		return -ERANGE;
+	chip->usb_in_voltage_uv = v_uv;
+	chip->usb_in_current_ua = sense_uv * 5;
+	chip->usb_input_valid = true;
+	return 0;
+}
