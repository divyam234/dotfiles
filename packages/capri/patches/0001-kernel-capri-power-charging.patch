+/*
+ * Motorola Moto G10 Power XT2127-4, capri SKU5.
+ * Inherit working Capri base and apply the factory 6000-mAh SKU profile.
+ * Stock DVT2 SKU5 board ID: <0x500 0xb200>.
+ * EVT SKU5 uses <0x500 0xa000> and is not selected here.
+ *
+ * EXPERIMENTAL: verify actual hardware board ID before trying fastboot.
+ */
+#include "sm4250-motorola-capri.dts"
+#include "capri-power-battery.dtsi"
+
+/ {
+	model = "Motorola Moto G10 Power (XT2127-4)";
+	compatible = "motorola,capri", "qcom,sm4250";
+	qcom,board-id = <0x500 0xb200>;
+};
