+/* Shadow safety policy for Power: read and classify, never configure or
+ * enable a charger. Stock Motorola uses *software* JEITA and a 768-minute
+ * safety timer; its 290 mA ITERM maps to a signed PMI632 ADC comparator.
+ * A readable register is NOT proof of a working protection mechanism.
+ */
+static void capri_power_audit(struct capri_battery *chip, bool gauge_ok)
+{
+	struct capri_power_hw_audit *hw = &chip->audit;
+	struct capri_power_policy_inputs in = {};
+	struct capri_control_observation o = {};
+	unsigned int value;
+	u8 iterm[2];
+	int ret = 0;
+	s64 now_ms;
+
+	hw->valid = false;
+	hw->read_error = 0;
+#define CAPRI_AUDIT_READ(_reg, _field) do {				\
+	ret = regmap_read(chip->map, (_reg), &value);			\
+	if (ret)							\
+		goto read_failed;					\
+	hw->_field = value;						\
+} while (0)
+	CAPRI_AUDIT_READ(CHGR_ENABLE, enable);
+	CAPRI_AUDIT_READ(CHGR_FCC, fcc);
+	CAPRI_AUDIT_READ(CHGR_FV, fv);
+	CAPRI_AUDIT_READ(CAPRI_JEITA_CONFIG, jeita);
+	CAPRI_AUDIT_READ(CAPRI_SAFETY_TIMER, safety_timer);
+	CAPRI_AUDIT_READ(WD_CFG, wd_cfg);
+	CAPRI_AUDIT_READ(WD_TIMEOUT, wd_timeout);
+	CAPRI_AUDIT_READ(CAPRI_ITERM_SOURCE, iterm_mode);
+	CAPRI_AUDIT_READ(CHGR_STATUS2, error);
+	CAPRI_AUDIT_READ(CHGR_STATUS7, temperature);
+#undef CAPRI_AUDIT_READ
+	ret = regmap_bulk_read(chip->map, CAPRI_ITERM_UPPER, iterm,
+			       sizeof(iterm));
+	if (ret)
+		goto read_failed;
+	hw->iterm_ua = div_s64((s64)(s16)get_unaligned_be16(iterm) *
+			      5000000, 32767);
+	hw->valid = true;
+	goto evaluate;
+
+read_failed:
+	hw->read_error = ret;
+
+evaluate:
+	in.gauge_sample_valid = gauge_ok;
+	in.battery_present = gauge_ok && chip->present;
+	in.usb_online = gauge_ok && chip->online;
+	in.usb_sample_valid = gauge_ok && chip->usb_input_valid;
+	in.usb_path_valid = gauge_ok && chip->input_path_valid;
+	in.aicl_done = gauge_ok && chip->aicl_done;
+	in.source_is_sdp = gauge_ok &&
+			chip->usb_type == POWER_SUPPLY_USB_TYPE_SDP;
+	in.battery_healthy = gauge_ok &&
+			chip->health == POWER_SUPPLY_HEALTH_GOOD;
+	in.charger_fault = hw->valid &&
+			((hw->error & BIT(1)) ||
+			 (hw->temperature & (BIT(3) | BIT(2))));
+	in.hw_read_valid = hw->valid;
+	in.charge_cmd_disabled = hw->valid && !(hw->enable & BIT(0));
+	/* Only check the watchdog has a bark IRQ, starts on plugin and
+	 * disables charging on bite. Motorola's observed 0x8c timeout
+	 * differs from the old JK50 profile; timing remains unvalidated.
+	 */
+	in.watchdog_cfg_matches = hw->valid &&
+			(hw->wd_cfg & (BIT(6) | BIT(1))) ==
+			(BIT(6) | BIT(1)) &&
+			(hw->wd_timeout & BIT(7));
+	in.timer_cfg_matches = hw->valid &&
+			(hw->safety_timer & GENMASK(1, 0)) == 2;
+	/* Motorola's qcom,iterm-ma=290 is an MMI policy parameter, not
+	 * necessarily the ADC comparator value at 0x1067. The stock
+	 * charge_term_current sysfs value is -102 mA, matching our
+	 * observed -101.8 mA. Check valid ADC mode and plausible range
+	 * here; actual termination behavior stays an unconditional block.
+	 */
+	in.iterm_cfg_matches = hw->valid &&
+			!(hw->iterm_mode & BIT(3)) &&
+			abs(hw->iterm_ua) >= 10000 &&
+			abs(hw->iterm_ua) <= 500000;
+	in.hw_charge_limits_match = hw->valid &&
+			hw->fcc > 0 && hw->fcc <= 60 &&
+			3600000 + hw->fv * 10000 >= 4000000 &&
+			3600000 + hw->fv * 10000 <= 4450000;
+	in.temperature_decic = gauge_ok ? chip->temperature : -1000;
+	in.battery_voltage_uv = gauge_ok ? chip->voltage : 0;
+	in.usb_voltage_uv = gauge_ok ? chip->usb_in_voltage_uv : 0;
+	in.usb_icl_ua = gauge_ok ? chip->usb_input_current_limit_ua : 0;
+	/* The policy always includes LOCKOUT and other unproven gates. */
+	hw->blockers = capri_power_policy_blockers(&in);
+	now_ms = ktime_to_ms(ktime_get_boottime());
+
+	o.usb_online = gauge_ok && chip->online;
+	o.usb_sample_valid = gauge_ok && chip->usb_input_valid;
+	o.usb_path_valid = gauge_ok && chip->input_path_valid;
+	o.aicl_done = gauge_ok && chip->aicl_done;
+	o.usb_sdp = gauge_ok &&
+		    chip->usb_type == POWER_SUPPLY_USB_TYPE_SDP;
+	o.usb_cdp = gauge_ok &&
+		    chip->usb_type == POWER_SUPPLY_USB_TYPE_CDP;
+	o.usb_dcp = gauge_ok &&
+		    chip->usb_type == POWER_SUPPLY_USB_TYPE_DCP;
+	o.battery_present = gauge_ok && chip->present;
+	o.gauge_valid = gauge_ok && hw->valid;
+	o.health_good = gauge_ok &&
+			chip->health == POWER_SUPPLY_HEALTH_GOOD;
+	o.charger_fault = in.charger_fault || !hw->valid;
+	o.watchdog_bark = READ_ONCE(chip->wdog_bark_latched);
+	/* Not calibrated while experimental Linux refuses charging.
+	 * The taper samples cannot advance from zero-current readings.
+	 */
+	o.charge_current_calibrated = false;
+	o.runtime_charge_enabled = charging && chip->charger_ready &&
+		chip->behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	o.charging_active = o.runtime_charge_enabled &&
+			    (hw->enable & BIT(0));
+	o.temperature_decic = gauge_ok ? chip->temperature : -1000;
+	o.battery_voltage_uv = gauge_ok ? chip->voltage : 0;
+	o.charge_current_ua = gauge_ok ? chip->current_ua : 0;
+	o.usb_voltage_uv = gauge_ok ? chip->usb_in_voltage_uv : 0;
+	o.usb_icl_ua = gauge_ok ? chip->usb_input_current_limit_ua : 0;
+	if (!o.usb_online) {
+		chip->session_online = false;
+	} else {
+		if (!chip->session_online) {
+			chip->session_online = true;
+			chip->session_start_ms = now_ms;
+		}
+		o.session_elapsed_ms = now_ms - chip->session_start_ms;
+	}
