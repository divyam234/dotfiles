+				float_voltage_uv : 0;
+			if (!chip->pmi632_float_uv) {
+				rc = -EINVAL;
+				goto out_put_batt_info;
+			}
+			fast_charge_current_ua = min(fast_charge_current_ua, 500000);
+		}
