+		    float_voltage_uv > match_data->fv_max_uv) {
+			rc = dev_err_probe(chip->dev, -EINVAL,
+					   "float voltage %d uV outside %u-%u uV\n",
+					   float_voltage_uv,
+					   match_data->fv_min_uv,
+					   match_data->fv_max_uv);
+			goto out_put_batt_info;
+		}
