+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Moto G10 Power (capri SKU5) battery data for initial kernel validation.
+ *
+ * Sources:
+ * LineageOS/android_kernel_motorola_sm6225, lineage-24.0:
+ *   bengal-capri-charge-6000-overlay.dtsi
+ *   qg-batterydata-atl4864356_5640mAh.dtsi
+ *
+ * OCV values below are the 25 C column from qcom,pc-temp-v1-lut
+ * (stock units: 0.1 mV, converted to microvolts). This is only a
+ * 25 C approximation; temperature-dependent fuel-gauge LUTs and
+ * charging behavior still require calibration and live verification.
+ *
+ * Stock profile: ATL4864356, 100 kOhm battery ID, 10 kOhm thermistor,
+ * beta 3435; 4.45 V / 3 A permitted by the factory configuration.
+ * These pack maxima describe hardware capabilities, not forced charging
+ * setpoints; the native SMB5 charger node remains disabled until JEITA/QG
+ * integration and device testing are complete.
+ */
+/ {
+	/* This node is declared in the regular Capri DTS; override it. */
+};
