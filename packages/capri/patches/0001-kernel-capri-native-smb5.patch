-#define CHGR_STATUS2            0x1007
-#define CHGR_STATUS7            0x100d
-#define USB_INT_RT              0x1310
-#define SAMPLE_MS               5000
-#define CHGR_ENABLE             0x1042
-#define CHGR_CFG2               0x1051
-#define CHGR_FCC                0x1061
