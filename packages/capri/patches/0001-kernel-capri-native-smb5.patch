+		label = "batt_therm_30k";
+	};
+};
+
 &spmi_bus {
- pmic@2 {
-  compatible = "qcom,pmi632", "qcom,spmi-pmic";
-  reg = <2 SPMI_USID>;
-  #address-cells = <1>;
-  #size-cells = <0>;
-  capri_adc: adc@3100 {
-   compatible = "qcom,spmi-adc5";
-   reg = <0x3100>;
-   #address-cells = <1>;
-   #size-cells = <0>;
-   #io-channel-cells = <1>;
-   interrupts = <0x2 0x31 0x0 IRQ_TYPE_EDGE_RISING>;
-   channel@1 {
-    reg = <0x01>;
-    qcom,pre-scaling = <1 1>;
-    label = "vref_1p25";
-   };
-   channel@2a {
-    reg = <0x2a>;
-    qcom,pre-scaling = <1 1>;
-    qcom,hw-settle-time = <200>;
-    qcom,ratiometric;
-    label = "batt_therm_30k";
-   };
-  };
-  battery-monitor@4800 {
-   compatible = "motorola,capri-pmi632-battery";
-   reg = <0x4800>;
-   monitored-battery = <&capri_battery>;
-   io-channels = <&capri_adc 0x2a>;
-   io-channel-names = "batt-therm";
-  };
- };
- pmic@3 {
-  compatible = "qcom,pmi632", "qcom,spmi-pmic";
-  reg = <3 SPMI_USID>;
-  #address-cells = <1>;
-  #size-cells = <0>;
- };
+	pmic@2 {
+		/*
+		 * Linux 7.2 qcom_smbx now supports the SMB5 generation.
+		 * These interrupts match the PMI632 vendor hardware DT.
+		 *
+		 * PMI632's charging enable is conditioned on the native QGauge,
+		 * thermal cutoff and watchdog. Default charging needs no boot args.
+		 */
+		pmi632_charger: charger@1000 {
+			compatible = "qcom,pmi632-charger";
+			reg = <0x1000>;
+
+			interrupts = <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "usb-plugin", "bat-ov",
+					  "wdog-bark", "usbin-icl-change";
+
+			io-channels = <&pmi632_adc ADC5_USB_IN_I>,
+				      <&pmi632_adc ADC5_USB_IN_V_16>;
+			io-channel-names = "usbin_i", "usbin_v";
+			monitored-battery = <&capri_battery>;
+			status = "okay";
+		};
+	};
 };
