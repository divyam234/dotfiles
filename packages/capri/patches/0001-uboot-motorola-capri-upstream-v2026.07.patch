diff --git a/dts/upstream/src/arm64/qcom/sm4250-motorola-capri-power.dts b/dts/upstream/src/arm64/qcom/sm4250-motorola-capri-power.dts
new file mode 100644
index 00000000..37f555ed
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm4250-motorola-capri-power.dts
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/dts-v1/;
+
+#include "sm4250.dtsi"
+#include "pm6125.dtsi"
+
+/ {
+	model = "Motorola Moto G10 Power (XT2127-4)";
+	compatible = "motorola,capri", "qcom,sm4250";
+	qcom,msm-id = <0x1a1 0x10000>;
+	qcom,board-id = <0x500 0xb200>;
+	/* ABL's vendor DT family; checked before importing runtime memory. */
+	u-boot,abl-compatible = "qcom,bengal-capri";
+
+	aliases {
+		mmc0 = &sdhc_1;
+		usb0 = &usb_dwc3;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		stdout-path = "framebuffer0";
+
+		/* ABL already drives the panel. Do not reset the display or rails. */
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5c000000 0 0x465000>;
+			width = <720>;
+			height = <1600>;
+			stride = <2880>;
+			format = "a8r8g8b8";
+			status = "okay";
+		};
+	};
+};
+
+/* Internal U-Boot control tree; ABL provides the live memory layout.
+ * The Capri board hook imports RAM banks and firmware reservations early.
+ */
+&smem_mem { status = "disabled"; };
+&gpu { status = "disabled"; };
+&remoteproc_mpss { status = "disabled"; };
+&remoteproc_adsp { status = "disabled"; };
+&remoteproc_cdsp { status = "disabled"; };
+&wifi { status = "disabled"; };
+&apps_smmu { status = "disabled"; };
+
+&xo_board { clock-frequency = <19200000>; };
+&sleep_clk { clock-frequency = <32764>; };
+
+/* PM6125 RPM supplies are already voted on by ABL. U-Boot has no RPM-SMD
+ * regulator driver for this PMIC: retain those votes rather than inventing
+ * fixed regulators or pretending to control them. Values match Capri Linux.
+ */
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm6125-regulators";
+
+		vreg_l4a: l4 {
+			regulator-min-microvolt = <488000>;
+			regulator-max-microvolt = <1000000>;
+		};
+		vreg_l11a: l11 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1952000>;
+		};
+		vreg_l12a: l12 {
+			regulator-min-microvolt = <1624000>;
+			regulator-max-microvolt = <1984000>;
+		};
+		vreg_l15a: l15 {
+			regulator-min-microvolt = <2920000>;
+			regulator-max-microvolt = <3232000>;
+		};
+		vreg_l24a: l24 {
+			regulator-min-microvolt = <2704000>;
+			regulator-max-microvolt = <3544000>;
+		};
+	};
+};
+
+&sdhc_1 {
+	vmmc-supply = <&vreg_l24a>;
+	vqmmc-supply = <&vreg_l11a>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdc1_state_on>;
+	non-removable;
+	max-frequency = <50000000>;
+	/* Keep the firmware's domain and DMA setup; Linux owns native policy. */
+	/delete-property/ power-domains;
+	/delete-property/ operating-points-v2;
+	/delete-property/ interconnects;
+	/delete-property/ interconnect-names;
+	/delete-property/ iommus;
+	status = "okay";
+};
+
+&tlmm { gpio-reserved-ranges = <14 4>; };
+
+&usb {
+	qcom,select-utmi-as-pipe-clk;
+	status = "okay";
+};
+
+&usb_dwc3 {
+	/delete-property/ usb-role-switch;
+	/* The disabled SMMU cannot be probed; retain ABL's DMA setup. */
+	/delete-property/ iommus;
+	maximum-speed = "high-speed";
+	dr_mode = "peripheral";
+	phys = <&usb_hsphy>;
+	phy-names = "usb2-phy";
+};
+
+&usb_hsphy {
+	vdd-supply = <&vreg_l4a>;
+	vdda-pll-supply = <&vreg_l12a>;
+	vdda-phy-dpdm-supply = <&vreg_l15a>;
+	status = "okay";
+};
+
+&pon_pwrkey { status = "okay"; };
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+/* Keep the three relevant firmware-DT properties identical to the
+ * already hardware-tested Capri control tree. Upstream's included
+ * sm6115/pm6125 nodes differ from Tauchgang's newer Linux DTS copy.
+ */
+&pm6125_rtc {
+	/delete-property/ status;
+};
+
+&mdss {
+	/* SM6115 DISP_CC_MDSS_CORE_BCR reset ID from the newer binding. */
+	resets = <&dispcc 0>;
+};
+
+&{/timer} {
+	interrupts = <GIC_PPI 1 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 2 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 3 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 0 IRQ_TYPE_LEVEL_LOW>;
+};
