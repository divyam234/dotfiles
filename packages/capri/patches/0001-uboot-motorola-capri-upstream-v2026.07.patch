diff --git a/arch/arm/mach-snapdragon/qcom-abl-memory.c b/arch/arm/mach-snapdragon/qcom-abl-memory.c
new file mode 100644
index 00000000..f113ced2
--- /dev/null
+++ b/arch/arm/mach-snapdragon/qcom-abl-memory.c
@@ -0,0 +1,576 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Merge runtime ABL memory and reservations into an upstream driver DT. */
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <asm/unaligned.h>
+#include <env_internal.h>
+#include <efi_loader.h>
+#include <fdt_support.h>
+#include <init.h>
+#include <linux/sizes.h>
+#include <malloc.h>
+#include "qcom-priv.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define QCOM_ABL_FDT_LIMIT SZ_2M
+#define QCOM_ABL_PAGE SZ_4K
+
+/* Used before BSS is cleared, and before even the early allocator is safe. */
+static unsigned char qcom_abl_fdt[SZ_128K]
+	__aligned(8) __section(".data") = { 0 };
+
+static bool range_valid(u64 start, u64 size)
+{
+	return size && start <= ~0ULL - size &&
+	       start + size <= ~0ULL - (QCOM_ABL_PAGE - 1);
+}
+
+static int check_blob(const void *fdt, size_t bound)
+{
+	uintptr_t addr = (uintptr_t)fdt;
+	u32 size;
+
+	if (!fdt || (addr & 7) || bound < sizeof(struct fdt_header) ||
+	    addr > UINTPTR_MAX - bound || fdt_check_header(fdt))
+		return -FDT_ERR_BADMAGIC;
+	size = fdt_totalsize(fdt);
+	if (size > bound || size < sizeof(struct fdt_header))
+		return -FDT_ERR_TRUNCATED;
+	return fdt_check_full(fdt, size);
+}
+
+static u64 cells_read(const fdt32_t *p, int cells)
+{
+	u64 value = fdt32_to_cpu(*p);
+
+	if (cells == 2)
+		value = (value << 32) | fdt32_to_cpu(p[1]);
+	return value;
+}
+
+static bool enabled(const void *fdt, int node)
+{
+	const char *status;
+	int len;
+
+	while (node > 0) {
+		status = fdt_getprop(fdt, node, "status", &len);
+		if (status && !((len == sizeof("okay") && !memcmp(status, "okay", len)) ||
+				(len == sizeof("ok") && !memcmp(status, "ok", len))))
+			return false;
+		node = fdt_parent_offset(fdt, node);
+	}
+	return true;
+}
+
+/* Resolve the existing /chosen simple-framebuffer, using its parent's
+ * address/size cell counts. Capri's reg has FOUR 32-bit cells (2+2),
+ * not two 64-bit cells to be checked using sizeof(fdt64_t).
+ * There is no fallback: never silently disable firmware memory protection.
+ */
+static int qcom_abl_framebuffer(const void *fdt, u64 *start, u64 *end)
+{
+	const fdt32_t *reg;
+	u64 size;
+	int chosen, node, ac, sc, len, count = 0;
+
+	chosen = fdt_path_offset(fdt, "/chosen");
+	if (chosen < 0)
+		return -FDT_ERR_NOTFOUND;
+	ac = fdt_address_cells(fdt, chosen);
+	sc = fdt_size_cells(fdt, chosen);
+	if ((ac != 1 && ac != 2) || (sc != 1 && sc != 2))
+		return -FDT_ERR_BADNCELLS;
+	fdt_for_each_subnode(node, fdt, chosen) {
+		if (!enabled(fdt, node) ||
+		    fdt_node_check_compatible(fdt, node, "simple-framebuffer"))
+			continue;
+		reg = fdt_getprop(fdt, node, "reg", &len);
+		if (!reg || len != (ac + sc) * sizeof(*reg) || ++count != 1)
+			return -FDT_ERR_BADVALUE;
+		*start = cells_read(reg, ac);
+		size = cells_read(reg + ac, sc);
+		if (!range_valid(*start, size) ||
+		    ((*start | size) & (QCOM_ABL_PAGE - 1)))
+			return -FDT_ERR_BADVALUE;
+		*end = *start + size;
+	}
+	return count == 1 ? 0 : -FDT_ERR_NOTFOUND;
+}
+
+/* LMB rejects partial overlaps and ranges crossing a memory-bank boundary.
+ * Keep a page-rounded union within each RAM bank; retain the original
+ * reserved-memory nodes separately for their CPU mapping policy.
+ */
+static int reserve_range(void *fdt, u64 start, u64 size)
+{
+	fdt64_t banks[CONFIG_NR_DRAM_BANKS * 2];
+	const fdt64_t *reg;
+	u64 end, base, limit, low, high, other, length;
+	int node, len, i, j, ret;
+
+	if (!range_valid(start, size))
+		return -FDT_ERR_BADVALUE;
+	end = ALIGN(start + size, QCOM_ABL_PAGE);
+	start = ALIGN_DOWN(start, QCOM_ABL_PAGE);
+	node = fdt_path_offset(fdt, "/memory");
+	reg = fdt_getprop(fdt, node, "reg", &len);
+	if (!reg || len <= 0 || len > sizeof(banks) || len % (2 * sizeof(*reg)))
+		return -FDT_ERR_BADVALUE;
+	/* Updating the reserve map moves the structure block and its properties. */
+	memcpy(banks, reg, len);
+	for (i = 0; i < len / sizeof(*banks); i += 2) {
+		base = fdt64_ld(&banks[i]);
+		limit = base + fdt64_ld(&banks[i + 1]);
+		low = max(start, base);
+		high = min(end, limit);
+		if (low >= high)
+			continue;
+		for (j = 0; j < fdt_num_mem_rsv(fdt);) {
+			ret = fdt_get_mem_rsv(fdt, j, &other, &length);
+			if (ret)
+				return ret;
+			if (other < base || other + length > limit ||
+			    other > high || other + length < low) {
+				j++;
+				continue;
+			}
+			low = min(low, other);
+			high = max(high, other + length);
+			ret = fdt_del_mem_rsv(fdt, j);
+			if (ret)
+				return ret;
+			/* An expanded union may now touch an earlier entry. */
+			j = 0;
+		}
+		ret = fdt_add_mem_rsv(fdt, low, high - low);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int import_memory(void *dst, const void *src)
+{
+	fdt64_t banks[CONFIG_NR_DRAM_BANKS * 2];
+	const fdt32_t *reg;
+	const char *type;
+	u64 start, size, other, other_size;
+	int node, len, count = 0, i, ac, sc, ret;
+
+	ac = fdt_address_cells(src, 0);
+	sc = fdt_size_cells(src, 0);
+	if ((ac != 1 && ac != 2) || (sc != 1 && sc != 2))
+		return -FDT_ERR_BADNCELLS;
+	fdt_for_each_subnode(node, src, 0) {
+		type = fdt_getprop(src, node, "device_type", &len);
+		if (!type || len != sizeof("memory") || strcmp(type, "memory") ||
+		    !enabled(src, node))
+			continue;
+		reg = fdt_getprop(src, node, "reg", &len);
+		if (!reg || len <= 0 || len % ((ac + sc) * sizeof(*reg)))
+			return -FDT_ERR_BADVALUE;
+		while (len) {
+			start = cells_read(reg, ac);
+			size = cells_read(reg + ac, sc);
+			if (!range_valid(start, size) || (start | size) & (QCOM_ABL_PAGE - 1) ||
+			    count == CONFIG_NR_DRAM_BANKS)
+				return -FDT_ERR_BADVALUE;
+			for (i = 0; i < count; i++) {
+				other = fdt64_to_cpu(banks[2 * i]);
+				other_size = fdt64_to_cpu(banks[2 * i + 1]);
+				if (start < other + other_size && other < start + size)
+					return -FDT_ERR_BADVALUE;
+			}
+			/* Ascending order also avoids the common parser's lossy comparator. */
+			for (i = count; i && fdt64_to_cpu(banks[2 * (i - 1)]) > start; i--) {
+				banks[2 * i] = banks[2 * (i - 1)];
+				banks[2 * i + 1] = banks[2 * (i - 1) + 1];
+			}
+			banks[2 * i] = cpu_to_fdt64(start);
+			banks[2 * i + 1] = cpu_to_fdt64(size);
+			count++;
+			reg += ac + sc;
+			len -= (ac + sc) * sizeof(*reg);
+		}
+	}
+	if (!count)
+		return -FDT_ERR_NOTFOUND;
+	/* Remove unit-addressed reference memory nodes as well as /memory. */
+	for (;;) {
+		fdt_for_each_subnode(node, dst, 0) {
+			const char *name = fdt_get_name(dst, node, NULL);
+
+			if (!strcmp(name, "memory") || !strncmp(name, "memory@", 7))
+				break;
+		}
+		if (node < 0)
+			break;
+		ret = fdt_del_node(dst, node);
+		if (ret)
+			return ret;
+	}
+	ret = fdt_setprop_u32(dst, 0, "#address-cells", 2);
+	if (ret)
+		return ret;
+	ret = fdt_setprop_u32(dst, 0, "#size-cells", 2);
+	if (ret)
+		return ret;
+	node = fdt_add_subnode(dst, 0, "memory");
+	if (node < 0)
+		return node;
+	ret = fdt_setprop_string(dst, node, "device_type", "memory");
+	if (ret)
+		return ret;
+	return fdt_setprop(dst, node, "reg", banks, count * 2 * sizeof(*banks));
+}
+
+/* Never copy downstream phandles, compatibles, or hardware references. Each
+ * tuple gets its own node so consumers which only read tuple zero remain safe.
+ */
+static int import_reservations(void *dst, const void *src)
+{
+	const fdt32_t *reg;
+	fdt64_t tuple[2];
+	u64 start, size, fb_start, fb_end;
+	char name[40];
+	int parent, node, out, root, ac, sc, len, n = 0, i, ret;
+
+	parent = fdt_path_offset(dst, "/reserved-memory");
+	if (parent >= 0) {
+		/* Any remaining reference is a control-DT integration error. */
+		int dev = -1, plen, j, target;
+		const fdt32_t *refs;
+
+		while ((dev = fdt_next_node(dst, dev, NULL)) >= 0) {
+			if (!enabled(dst, dev))
+				continue;
+			refs = fdt_getprop(dst, dev, "memory-region", &plen);
+			if (!refs)
+				continue;
+			if (plen <= 0 || plen % sizeof(*refs))
+				return -FDT_ERR_BADPHANDLE;
+			for (j = 0; j < plen / sizeof(*refs); j++) {
+				target = fdt_node_offset_by_phandle(dst, fdt32_to_cpu(refs[j]));
+				if (target >= 0 && fdt_parent_offset(dst, target) == parent)
+					return -FDT_ERR_BADPHANDLE;
+			}
+		}
+		ret = fdt_del_node(dst, parent);
+		if (ret)
+			return ret;
+	}
+	/* No reference-tree reserve map survives either. */
+	while (fdt_num_mem_rsv(dst)) {
+		ret = fdt_del_mem_rsv(dst, 0);
+		if (ret)
+			return ret;
+	}
+	root = fdt_add_subnode(dst, 0, "reserved-memory");
+	if (root < 0)
+		return root;
+	ret = fdt_setprop_u32(dst, root, "#address-cells", 2);
+	if (ret)
+		return ret;
+	ret = fdt_setprop_u32(dst, root, "#size-cells", 2);
+	if (ret)
+		return ret;
+	ret = fdt_setprop(dst, root, "ranges", NULL, 0);
+	if (ret)
+		return ret;
+	parent = fdt_path_offset(src, "/reserved-memory");
+	if (parent >= 0) {
+		ac = fdt_address_cells(src, parent);
+		sc = fdt_size_cells(src, parent);
+		if ((ac != 1 && ac != 2) || (sc != 1 && sc != 2))
+			return -FDT_ERR_BADNCELLS;
+		reg = fdt_getprop(src, parent, "ranges", &len);
+		if (!reg || len)
+			return -FDT_ERR_BADVALUE;
+		fdt_for_each_subnode(node, src, parent) {
+			reg = fdt_getprop(src, node, "reg", &len);
+			/* Dynamic pools have no physical reservation yet. */
+			if (!reg)
+				continue;
+			if (len <= 0 || len % ((ac + sc) * sizeof(*reg)))
+				return -FDT_ERR_BADVALUE;
+			while (len) {
+				start = cells_read(reg, ac);
+				size = cells_read(reg + ac, sc);
+				ret = reserve_range(dst, start, size);
+				if (ret)
+					return ret;
+				snprintf(name, sizeof(name), "firmware-%d@%llx", n++, start);
+				out = fdt_add_subnode(dst, root, name);
+				if (out < 0)
+					return out;
+				tuple[0] = cpu_to_fdt64(start);
+				tuple[1] = cpu_to_fdt64(size);
+				ret = fdt_setprop(dst, out, "reg", tuple, sizeof(tuple));
+				if (ret)
+					return ret;
+				if (fdt_getprop(src, node, "no-map", NULL)) {
+					ret = fdt_setprop(dst, out, "no-map", NULL, 0);
+					if (ret)
+						return ret;
+				}
+				/* Do not retain reusable: firmware may still own the pool. */
+				reg += ac + sc;
+				len -= (ac + sc) * sizeof(*reg);
+			}
+		}
+	}
+	for (i = 0; i < fdt_num_mem_rsv(src); i++) {
+		ret = fdt_get_mem_rsv(src, i, &start, &size);
+		if (ret)
+			return ret;
+		ret = reserve_range(dst, start, size);
+		if (ret)
+			return ret;
+	}
+	ret = qcom_abl_framebuffer(dst, &fb_start, &fb_end);
+	if (ret)
+		return ret;
+	return reserve_range(dst, fb_start, fb_end - fb_start);
+}
+
+static bool in_ram(const void *fdt, u64 start, u64 size)
+{
+	const fdt64_t *reg;
+	u64 base, length;
+	int node, len, i;
+
+	if (!range_valid(start, size))
+		return false;
+	node = fdt_path_offset(fdt, "/memory");
+	reg = fdt_getprop(fdt, node, "reg", &len);
+	for (i = 0; reg && i < len / sizeof(*reg); i += 2) {
+		base = get_unaligned_be64(&reg[i]);
+		length = get_unaligned_be64(&reg[i + 1]);
+		if (start >= base && start + size <= base + length)
+			return true;
+	}
+	return false;
+}
+
+/* Pure libfdt merge entry point: all buffers are bounded, no allocation or GD.
+ * Failure leaves scratch unusable; neither input is ever modified. */
+int qcom_abl_merge_fdt(const void *control, size_t control_bound,
+			 const void *firmware, size_t firmware_bound,
+			 void *scratch, size_t scratch_size)
+{
+	const fdt32_t *id, *expected_id, *prop;
+	const char *args, *compatible;
+	u64 start, end;
+	int ret, len, expected_len, compatible_len, chosen, out;
+
+	ret = check_blob(control, control_bound);
+	if (ret)
+		return ret;
+	ret = check_blob(firmware, firmware_bound);
+	if (ret)
+		return ret;
+	/* Require the firmware family explicitly declared by the board DT.
+	 * Check the property is a bounded, NUL-terminated single string. */
+	compatible = fdt_getprop(control, 0, "u-boot,abl-compatible", &compatible_len);
+	if (!compatible || compatible_len < 2 ||
+	    compatible[compatible_len - 1] != '\0' ||
+	    strnlen(compatible, compatible_len) != compatible_len - 1 ||
+	    fdt_node_check_compatible(firmware, 0, compatible))
+		return -FDT_ERR_BADVALUE;
+	expected_id = fdt_getprop(control, 0, "qcom,board-id", &expected_len);
+	id = fdt_getprop(firmware, 0, "qcom,board-id", &len);
+	if (!expected_id || !id || expected_len != 8 || len != expected_len ||
+	    memcmp(id, expected_id, len))
+		return -FDT_ERR_BADVALUE;
+	if (!scratch || ((uintptr_t)scratch & 7) || scratch_size > QCOM_ABL_FDT_LIMIT ||
+	    scratch_size < fdt_totalsize(control) ||
+	    (uintptr_t)scratch > UINTPTR_MAX - scratch_size ||
+	    ((uintptr_t)scratch < (uintptr_t)control + fdt_totalsize(control) &&
+	     (uintptr_t)control < (uintptr_t)scratch + scratch_size) ||
+	    ((uintptr_t)scratch < (uintptr_t)firmware + fdt_totalsize(firmware) &&
+	     (uintptr_t)firmware < (uintptr_t)scratch + scratch_size))
+		return -FDT_ERR_NOSPACE;
+	ret = fdt_open_into(control, scratch, scratch_size);
+	if (ret)
+		return ret;
+	ret = import_memory(scratch, firmware);
+	if (ret)
+		return ret;
+	ret = import_reservations(scratch, firmware);
+	if (ret)
+		return ret;
+	if (!in_ram(scratch, (uintptr_t)firmware, fdt_totalsize(firmware)))
+		return -FDT_ERR_BADVALUE;
+	ret = reserve_range(scratch, (uintptr_t)firmware, fdt_totalsize(firmware));
+	if (ret)
+		return ret;
+	chosen = fdt_path_offset(firmware, "/chosen");
+	out = fdt_path_offset(scratch, "/chosen");
+	if (out < 0)
+		out = fdt_add_subnode(scratch, 0, "chosen");
+	if (out < 0)
+		return out;
+	/* Retain only ABL's serial/boot metadata, not its console or hardware DT. */
+	args = fdt_getprop(firmware, chosen, "bootargs", &len);
+	if (args) {
+		if (len <= 0 || args[len - 1])
+			return -FDT_ERR_BADVALUE;
+		ret = fdt_setprop(scratch, out, "bootargs", args, len);
+		if (ret)
+			return ret;
+	}
+	prop = fdt_getprop(firmware, chosen, "linux,initrd-start", &len);
+	if (prop) {
+		if (len != 4 && len != 8)
+			return -FDT_ERR_BADVALUE;
+		start = cells_read(prop, len / 4);
+		prop = fdt_getprop(firmware, chosen, "linux,initrd-end", &len);
+		if (!prop || (len != 4 && len != 8))
+			return -FDT_ERR_BADVALUE;
+		end = cells_read(prop, len / 4);
+		if (end <= start || !in_ram(scratch, start, end - start))
+			return -FDT_ERR_BADVALUE;
+		/* Keep it safe, but do not advertise an old Android initrd to Linux. */
+		ret = reserve_range(scratch, start, end - start);
+		if (ret)
+			return ret;
+	}
+	return fdt_pack(scratch);
+}
+
+int qcom_abl_fdt_setup(void **fdtp, const void *firmware)
+{
+	int ret;
+
+	ret = qcom_abl_merge_fdt(*fdtp, QCOM_ABL_FDT_LIMIT, firmware,
+				 QCOM_ABL_FDT_LIMIT, qcom_abl_fdt, sizeof(qcom_abl_fdt));
+	if (!ret)
+		*fdtp = qcom_abl_fdt;
+	return ret;
+}
+
+/* The entire pre-relocation arena must fit one gap, not just U-Boot's image.
+ * The 16 MiB headroom covers the fixed 720x1600 video buffer, page tables,
+ * FDT, GD and stack; the configured malloc arena is accounted separately.
+ */
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	const fdt64_t *banks;
+	u64 base, top, start, size, low, best = 0;
+	u64 need = total_size + TOTAL_MALLOC_LEN + SZ_16M;
+	int len, node, i, j;
+	bool again;
+
+	node = fdt_path_offset(gd->fdt_blob, "/memory");
+	banks = fdt_getprop(gd->fdt_blob, node, "reg", &len);
+	for (i = 0; i < len / sizeof(*banks); i += 2) {
+		base = get_unaligned_be64(&banks[i]);
+		top = base + get_unaligned_be64(&banks[i + 1]);
+		do {
+			again = false;
+			low = base;
+			for (j = 0; j < fdt_num_mem_rsv(gd->fdt_blob); j++) {
+				fdt_get_mem_rsv(gd->fdt_blob, j, &start, &size);
+				if (start < top && start + size > base) {
+					if (start + size >= top) {
+						top = max(base, start);
+						again = true;
+						break;
+					}
+					low = max(low, start + size);
+				}
+			}
+			top = ALIGN_DOWN(top, SZ_64K);
+			if (!again && top >= low && top - low >= need) {
+				best = max(best, top);
+				break;
+			}
+			if (!again && low > base) {
+				top = low;
+				again = true;
+			}
+		} while (again && top > base);
+	}
+	if (!best)
+		panic("Qualcomm ABL: no safe contiguous relocation arena\n");
+	return best;
+}
+
+/* Emit page-granular RAM/device mappings with no-map holes already absent.
+ * This protects BOTH page tables before the MMU is first enabled, unlike a
+ * post-construction attribute change which also touches live cache state.
+ */
+void qcom_abl_mem_map(struct mm_region *map, int capacity)
+{
+	struct mm_region source[CONFIG_NR_DRAM_BANKS + 2];
+	u64 pos, end, stop, start, size, hole_end, fb_start, fb_end;
+	const fdt64_t *reg;
+	int s, parent, node, len, n = 0;
+
+	memcpy(source, map, sizeof(source));
+	memset(map, 0, capacity * sizeof(*map));
+	if (qcom_abl_framebuffer(gd->fdt_blob, &fb_start, &fb_end))
+		panic("Qualcomm ABL: missing or invalid framebuffer\n");
+	parent = fdt_path_offset(gd->fdt_blob, "/reserved-memory");
+	for (s = 0; source[s].size; s++) {
+		pos = source[s].phys;
+		end = pos + source[s].size;
+		while (pos < end) {
+			stop = end;
+			hole_end = pos;
+			fdt_for_each_subnode(node, gd->fdt_blob, parent) {
+				if (!fdt_getprop(gd->fdt_blob, node, "no-map", NULL))
+					continue;
+				reg = fdt_getprop(gd->fdt_blob, node, "reg", &len);
+				start = ALIGN_DOWN(get_unaligned_be64(&reg[0]), QCOM_ABL_PAGE);
+				size = get_unaligned_be64(&reg[1]);
+				size = ALIGN(get_unaligned_be64(&reg[0]) + size, QCOM_ABL_PAGE);
+				/* Firmware framebuffer is the sole intentional no-map access. */
+				if (pos >= fb_start && pos < fb_end)
+					continue;
+				if (start < fb_end && size > fb_start) {
+					if (pos >= fb_end)
+						start = max(start, fb_end);
+					else
+						size = min(size, fb_start);
+				}
+				if (start <= pos && size > pos)
+					hole_end = max(hole_end, min(size, end));
+				else if (start > pos)
+					stop = min(stop, start);
+			}
+			if (hole_end > pos) {
+				pos = hole_end;
+				continue;
+			}
+			if (pos < fb_start)
+				stop = min(stop, fb_start);
+			else if (pos < fb_end)
+				stop = min(stop, fb_end);
+			if (n >= capacity - 1)
+				panic("Qualcomm ABL: memory map capacity exceeded\n");
+			map[n] = source[s];
+			map[n].phys = pos;
+			map[n].virt = pos;
+			map[n++].size = stop - pos;
+			pos = stop;
+		}
+	}
+}
+
+#if CONFIG_IS_ENABLED(EFI_LOADER)
+void efi_add_known_memory(void)
+{
+	u64 start, size;
+	int i;
+
+	/* Use the control tree even when EFI later receives a separate Linux DT. */
+	for (i = 0; i < fdt_num_mem_rsv(gd->fdt_blob); i++) {
+		fdt_get_mem_rsv(gd->fdt_blob, i, &start, &size);
+		if (efi_add_memory_map(start, size, EFI_RESERVED_MEMORY_TYPE) != EFI_SUCCESS)
+			panic("Qualcomm ABL: unable to protect firmware memory from EFI\n");
+	}
+}
+#endif
