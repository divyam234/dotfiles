+bootdelay=3
+stdin=serial,button-kbd
+stdout=serial,vidconsole
+stderr=serial,vidconsole
+
+# EFI boot manager starts first; manual storage commands remain available at the shell.
+preboot=echo Motorola Capri Power - Official U-Boot; mmc dev 0; mmc rescan; mmc info
+bootcmd=bootefi bootmgr; run menucmd
+menucmd=bootmenu -1
