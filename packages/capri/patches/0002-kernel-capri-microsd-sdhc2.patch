diff --git a/arch/arm64/boot/dts/qcom/sm4250-motorola-capri.dts b/arch/arm64/boot/dts/qcom/sm4250-motorola-capri.dts
index a327d4dc0..051006b9c 100644
--- a/arch/arm64/boot/dts/qcom/sm4250-motorola-capri.dts
+++ b/arch/arm64/boot/dts/qcom/sm4250-motorola-capri.dts
@@ -17,7 +17,7 @@ / {
  qcom,msm-id = <0x1a1 0x10000>;
  qcom,board-id = <0 0xb200>;
 
- aliases { mmc0 = &sdhc_1; spi2 = &spi2; serial0 = &uart3; };
+ aliases { mmc0 = &sdhc_1; mmc1 = &sdhc_2; spi2 = &spi2; serial0 = &uart3; };
  chosen {
   #address-cells = <2>;
   #size-cells = <2>;
@@ -402,6 +402,28 @@ &sdhc_1 {
  status = "okay";
 };
 
+/* Original Motorola Capri DVT2 Power (0x500/0xb200) SD wiring:
+ * L22A card power, L5A IO, SDC2 pinmux, GPIO88 card-detect.
+ */
+&sdhc_2 {
+ vmmc-supply = <&vreg_l22a>;
+ vqmmc-supply = <&vreg_l5a>;
+ cd-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
+ pinctrl-names = "default", "sleep";
+ pinctrl-0 = <&sdc2_state_on &sdc2_card_det_n>;
+ pinctrl-1 = <&sdc2_state_off &sdc2_card_det_n>;
+ status = "okay";
+};
+
+&tlmm {
+ sdc2_card_det_n: sd-card-det-n-state {
+  pins = "gpio88";
+  function = "gpio";
+  drive-strength = <2>;
+  bias-pull-up;
+ };
+};
+
 &usb {
  /* The USB-C connector uses the HS PHY only. */
  qcom,select-utmi-as-pipe-clk;
