-&tlmm { gpio-reserved-ranges = <14 4>; };
+/* XT2127-4 DVT2 SKU5 overlay (board-id 0x500/0xb200): L22A/L5A,
+ * SDC2 pins, and active-high GPIO88 card-detect. Preserve ABL's existing
+ * RPM regulator votes; do not attempt unsupported PM6125 RPM control here.
+ */
+&sdhc_2 {
+	vmmc-supply = <&vreg_l22a>;
+	vqmmc-supply = <&vreg_l5a>;
+	cd-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_state_on &sdc2_card_det_n>;
+	pinctrl-1 = <&sdc2_state_off &sdc2_card_det_n>;
+	max-frequency = <50000000>;
+	/delete-property/ power-domains;
+	/delete-property/ operating-points-v2;
+	/delete-property/ interconnects;
+	/delete-property/ interconnect-names;
+	/delete-property/ iommus;
+	status = "okay";
+};
+
+&tlmm {
+	gpio-reserved-ranges = <14 4>;
+	sdc2_card_det_n: sd-card-det-n-state {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
 
