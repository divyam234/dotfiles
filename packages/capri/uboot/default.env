bootdelay=3
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Load addresses are allocated by Snapdragon board_late_init(), not hard-coded.
preboot=echo Motorola Capri Power - NixOS; mmc dev 0; mmc rescan; mmc info
bootcmd=run boot_nixos; run menucmd
boot_nixos=if mmc dev 0 && mmc rescan && part uuid mmc 0:77 capri_root_uuid && test "${capri_root_uuid}" = "f6eb68be-3488-aaba-703b-eb107625d212"; then sysboot mmc 0:77 ext2 ${scriptaddr} /boot/extlinux/extlinux.conf; else echo Capri userdata partition unavailable or GUID mismatch; fi
menucmd=bootmenu -1
serial_gadget=echo Open the USB serial port on the host; setenv stdin usbacm && setenv stdin serial,button-kbd,usbacm && setenv stdout serial,vidconsole,usbacm && setenv stderr serial,vidconsole,usbacm && echo USB serial console enabled

bootmenu_0=Boot NixOS=run boot_nixos
bootmenu_1=Enable USB serial console=run serial_gadget
bootmenu_2=List eMMC partitions (read-only)=part list mmc 0; pause
bootmenu_3=Board and RAM information=bdinfo; pause
bootmenu_4=U-Boot shell=echo Use USB serial console for shell input
bootmenu_5=Restart phone=reset

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
