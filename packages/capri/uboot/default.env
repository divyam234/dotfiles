# Enter bootcmd immediately; the visible bootmenu owns the countdown.
bootdelay=-2
bootmenu_delay=6
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# No automatic flashing, capsule update, block mapping or mass-storage export.
preboot=echo Motorola Capri Power - diagnostics and recovery; echo Volume Up/Down to navigate - Power to select; echo Default NixOS boot in 6 seconds - press a key to stop
# Boot only internal eMMC (userdata); never scan microSD.
# Keep EFI as a manual recovery option rather than auto-booting it.
boot_targets=mmc0
bootmeths=extlinux
bootcmd=bootmenu 6
menucmd=bootmenu -1
# Start ACM alone first: console mux otherwise hides its failure if buttons work.
# ACM startup waits for the host to open the port.
serial_gadget=echo Open the USB serial port on the host; setenv stdin usbacm && setenv stdin serial,button-kbd,usbacm && setenv stdout serial,vidconsole,usbacm && setenv stderr serial,vidconsole,usbacm && echo USB serial console enabled

bootmenu_0=Boot NixOS generations=bootflow scan -lb mmc0:0x4d
bootmenu_1=Enable USB serial console=run serial_gadget
bootmenu_2=List eMMC partitions (read-only)=mmc dev 0; part list mmc 0; pause
bootmenu_3=Board and RAM information=bdinfo; pause
bootmenu_4=U-Boot shell=echo Use USB serial console for shell input
bootmenu_5=Reboot bootloader=capri_bootloader
bootmenu_6=Restart phone=reset
bootmenu_7=Boot EFI system (manual)=bootefi bootmgr

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
